{
  "name": "object-storage-system",
  "version": "0.1.0",
  "private": true,
  "description": "S3-shaped object storage service built on NestJS + Sequelize",
  "scripts": {
    "build": "nest build",
    "build:sdk": "npm --prefix packages/sdk run build",
    "typecheck": "tsc --noEmit --incremental false -p tsconfig.build.json",
    "typecheck:sdk": "npm --prefix packages/sdk run typecheck",
    "test:sdk": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --runInBand --runTestsByPath packages/sdk/tests/sdk.integration.spec.ts packages/sdk/tests/sdk.transport.spec.ts src/multipart/tests/multipart.service.spec.ts src/access-control/tests/presigned-url.spec.ts",
    "start": "nest start",
    "dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "lint": "eslint \"src/**/*.ts\" \"packages/sdk/tests/**/*.ts\" --fix",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js",
    "test:e2e": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --runInBand --runTestsByPath packages/sdk/tests/sdk.integration.spec.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.629.0",
    "@nestjs/common": "^12.4.2",
    "@nestjs/config": "^12.1.1",
    "@nestjs/core": "^12.4.2",
    "@nestjs/event-emitter": "^12.0.2",
    "@nestjs/platform-express": "^12.4.2",
    "@nestjs/schedule": "^12.0.3",
    "@nestjs/sequelize": "^12.0.1",
    "@nestjs/swagger": "^12.1.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "pg": "^8.12.0",
    "pg-hstore": "^2.3.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sequelize": "^6.37.3",
    "sequelize-typescript": "^2.1.6",
    "uuid": "^14.0.3"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.12",
    "@nestjs/schematics": "^12.0.13",
    "@nestjs/testing": "^12.4.2",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.6",
    "@types/supertest": "^7.2.1",
    "jest": "^30.5.2",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.4",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^6.0.3"
  }
}
