# Server
PORT=4000

# Database — Postgres is the default; sqlite3 needs native bindings that
# don't always have prebuilt binaries available, so it's opt-in below
# instead of the default.
DB_DIALECT=postgres
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD='root'
DB_NAME=object_storage

# To use sqlite instead for zero-setup local dev, install sqlite3
# (`npm install sqlite3`) and switch to:
# DB_DIALECT=sqlite
# DB_STORAGE=./data/metadata.sqlite

# Storage backend: local | s3
STORAGE_ADAPTER=local
STORAGE_LOCAL_ROOT=./data/blobs

# Only needed when STORAGE_ADAPTER=s3
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=us-east-1

# Signing / encryption
REQUEST_SIGNING_SECRET=dev-signing-secret-change-me
ENCRYPTION_MASTER_KEY=dev-32-byte-minimum-master-key!!
PRESIGNED_URL_SECRET=dev-presigned-secret-change-me
