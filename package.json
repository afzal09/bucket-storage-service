    "@nestjs/sequelize": "^10.0.1",
    "@nestjs/config": "^3.2.3",
    "@nestjs/schedule": "^4.1.0",
    "@nestjs/event-emitter": "^2.0.4",
    "sequelize": "^6.37.3",
    "sequelize-typescript": "^2.1.6",
    "pg": "^8.12.0",
    "pg-hstore": "^2.3.4",
    "class-validator": "^0.14.1",
